# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging
build/
dist/
wheels/
sdist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/

# Matplotlib local caches. MPLCONFIGDIR is pointed at .mplcache so a sandboxed
